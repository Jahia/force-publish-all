{
    "name": "@jahia/force-publish-all",
    "version": "1.0.0",
    "scripts": {
        "build": "yarn webpack",
        "webpack": "webpack",
        "build:analyze": "yarn build --analyze",
        "build:production": "yarn build --mode=production",
        "build:production-analyze": "yarn build:production --analyze",
        "watch": "yarn webpack --watch",
        "clean": "rimraf *.log src/main/resources/javascript/apps",
        "clean:all": "yarn clean && rimraf node_modules node",
        "test": "jest --coverage ./src/javascript",
        "tdd": "jest --watch ./src/javascript",
        "lint:js": "eslint --ext js,jsx src",
        "lint:js:fix": "yarn lint:js --fix src",
        "lint:scss": "stylelint --allow-empty-input \"./src/**/*.scss\"",
        "lint:scss:fix": "yarn lint:scss --fix",
        "lint": "yarn lint:scss && yarn lint:js",
        "lint:fix": "yarn lint:js:fix && yarn lint:scss:fix"
    },
    "description": "Force publish all for Jahia",
    "main": "index.js",
    "packageManager": "yarn@1.22.22",
    "repository": "git@github.com:Jahia/force-publish-all.git",
    "author": "Jahia Customer Support Team <support@jahia.com>",
    "license": "MIT",
    "jahia": {
        "remotes": {
            "jahia": "javascript/apps/remoteEntry.js"
        }
    },
    "husky": {
        "hooks": {
            "pre-commit": "./node/node ./node/yarn/dist/bin/yarn.js lint --max-warnings 1",
            "pre-push": " ./node/node ./node/yarn/dist/bin/yarn.js test"
        }
    },
    "jest": {
        "testEnvironment": "jsdom",
        "moduleNameMapper": {
            "\\.(scss|css)$": "identity-obj-proxy"
        },
        "transform": {
            "^.+\\.jsx?$": [
                "babel-jest",
                {
                    "configFile": false,
                    "presets": [
                        "@babel/preset-env",
                        [
                            "@babel/preset-react",
                            {
                                "runtime": "classic"
                            }
                        ]
                    ]
                }
            ]
        }
    },
    "dependencies": {
        "@apollo/react-hooks": "^3",
        "@jahia/data-helper": "1.0.9",
        "@jahia/moonstone": "~2.11.3",
        "@jahia/ui-extender": "^1.3.0",
        "@material-ui/core": "^3.9.3",
        "graphql": "^15.4.0",
        "graphql-tag": "^2.12.6",
        "i18next": "^21.6.14",
        "prop-types": "^15.7.2",
        "react": "^16",
        "react-dom": "^16",
        "react-i18next": "^11.14.3"
    },
    "resolutions": {
        "braces": "^3.0.3",
        "flatted": "^3.4.2",
        "form-data": "^3.0.4",
        "lodash": "^4.18.1",
        "minimatch": "^3.1.3",
        "node-fetch": "^2.6.7",
        "rollup": "^2.80.0",
        "serialize-javascript": "^7.0.5",
        "tmp": "^0.2.6",
        "immutable": "^4.3.8",
        "@babel/runtime": "^7.26.10",
        "strip-ansi": "^6.0.1",
        "string-width": "^4.2.3",
        "wrap-ansi": "^7.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.16.0",
        "@babel/eslint-parser": "^7.16.0",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/preset-env": "^7.16.4",
        "@babel/preset-react": "^7.16.0",
        "@jahia/eslint-config": "^2.2.0",
        "@jahia/stylelint-config": "^0.0.3",
        "@testing-library/react": "^11.2.7",
        "babel-jest": "^27.4.6",
        "babel-loader": "^8.2.3",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^10.0.0",
        "css-loader": "^6.5.1",
        "eslint": "^8.4.1",
        "eslint-plugin-jest": "^25.3.0",
        "eslint-plugin-react": "^7.27.1",
        "eslint-plugin-react-hooks": "^4.3.0",
        "file-loader": "^6.2.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^27.4.7",
        "postcss-scss": "^4.0.2",
        "sass": "^1.52.1",
        "sass-loader": "^12.4.0",
        "style-loader": "^3.3.1",
        "stylelint": "^13.2.0",
        "webpack": "^5.104.1",
        "webpack-bundle-analyzer": "^4.5.0",
        "webpack-cli": "^4.9.2"
    }
}
