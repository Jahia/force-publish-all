{
  "name": "@jahia/force-publish-all",
  "version": "1.0.0",
  "scripts": {
    "build": "yarn webpack",
    "webpack": "webpack",
    "build:analyze": "yarn build --analyze",
    "build:production": "yarn build --mode=production",
    "build:production-analyze": "yarn build:production --analyze",
    "watch": "yarn webpack --watch",
    "clean": "rimraf *.log src/main/resources/javascript/apps",
    "clean:all": "yarn clean && rimraf node_modules node",
    "test": "jest --coverage ./src/javascript",
    "tdd": "jest --watch ./src/javascript",
    "lint:js": "eslint --ext js,jsx src",
    "lint:js:fix": "yarn lint:js --fix src",
    "lint:scss": "stylelint --allow-empty-input \"./src/**/*.scss\"",
    "lint:scss:fix": "yarn lint:scss --fix",
    "lint": "yarn lint:scss && yarn lint:js",
    "lint:fix": "yarn lint:js:fix && yarn lint:scss:fix"
  },
  "description": "Force publish all for Jahia",
  "main": "index.js",
  "packageManager": "yarn@1.22.22",
  "repository": "git@github.com:Jahia/force-publish-all.git",
  "author": "Jahia Customer Support Team <support@jahia.com>",
  "license": "MIT",
  "jahia": {
    "remotes": {
      "jahia": "javascript/apps/remoteEntry.js"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "./node/node ./node/yarn/dist/bin/yarn.js lint --max-warnings 1",
      "pre-push": " ./node/node ./node/yarn/dist/bin/yarn.js test"
    }
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.(scss|css)$": "identity-obj-proxy"
    },
    "transform": {
      "^.+\\.jsx?$": [
        "babel-jest",
        {
          "configFile": false,
          "presets": [
            "@babel/preset-env",
            [
              "@babel/preset-react",
              {
                "runtime": "classic"
              }
            ]
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@apollo/react-hooks": "^3",
    "@jahia/data-helper": "1.0.12",
    "@jahia/moonstone": "~2.11.3",
    "@jahia/ui-extender": "^1.3.0",
    "@material-ui/core": "^3.9.3",
    "graphql": "^15.10.3",
    "graphql-tag": "^2.12.7",
    "i18next": "^21.6.14",
    "prop-types": "^15.7.2",
    "react": "^16",
    "react-dom": "^16",
    "react-i18next": "^11.14.3"
  },
  "resolutions": {
    "**/@jest/reporters/glob": "^14.0.3",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.5",
    "**/git-branch/findup-sync": "^5.0.0",
    "**/jest-config/glob": "^14.0.3",
    "**/jest-runtime/glob": "^14.0.3",
    "**/test-exclude/glob": "^14.0.3",
    "**/test-exclude/minimatch": "^11.0.5",
    "@babel/core": "^7.29.6",
    "@babel/runtime": "^7.26.10",
    "baseline-browser-mapping": "^2.11.22",
    "braces": "^3.0.3",
    "browserslist": "^4.28.9",
    "fast-uri": "^3.1.9",
    "flatted": "^3.4.2",
    "form-data": "^3.0.5",
    "immutable": "^4.3.9",
    "internal-slot": "^1.1.0",
    "lodash": "^4.18.1",
    "node-fetch": "^2.6.7",
    "postcss": "^8.5.23",
    "rollup": "^2.80.0",
    "serialize-javascript": "^7.1.3",
    "source-map-js": "^1.2.2",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "tmp": "^0.2.6",
    "wrap-ansi": "^7.0.0",
    "ws": "^7.5.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@jahia/eslint-config": "^2.2.0",
    "@testing-library/react": "^12.1.5",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.4.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss-scss": "^4.0.2",
    "sass": "^1.108.1",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "stylelint": "^16.26.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.1",
    "webpack-cli": "^7.3.1"
  }
}
